# FinNexus — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit this file to git.

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Supported: openai | groq | anthropic | gemini | mistral | cohere | ollama
LLM_PROVIDER=groq
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemma2-9b-it
# Optional: only needed for ollama or custom endpoints
LLM_BASE_URL=

# ── Supabase (leave blank to use local SQLite fallback) ──────────────────────
SUPABASE_URL=
SUPABASE_KEY=

# ── News API (optional — static fallback headlines used if blank) ─────────────
NEWSAPI_KEY=

# ── ChromaDB (optional — defaults to Data/chroma_db/ inside the project) ─────
CHROMA_PERSIST_PATH=

# ── ML Model artifacts directory ─────────────────────────────────────────────
MODEL_DIR=

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_TIMEOUT_SECONDS=3600

# ── Redis (optional — falls back to SQLite session store if blank) ────────────
REDIS_URL=

# ── Backend Auth & Security ───────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
FINNEXUS_API_KEY=
# CORS origins (comma-separated). Defaults to localhost dev ports.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ── Frontend ──────────────────────────────────────────────────────────────────
# Set to the backend URL when deploying; leave as default for local dev.
VITE_API_URL=http://localhost:8000
# Set to "true" to enable live API calls instead of mock data.
VITE_USE_API=false

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
