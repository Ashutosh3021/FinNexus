# FinNexus — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to git — it is listed in .gitignore.
#
# REQUIRED FOR PRODUCTION (server will refuse to start without these):
#   JWT_SECRET   — must be a strong random string (not the placeholder below)
#   CORS_ORIGINS — must be your frontend domain; no localhost
#   ENV          — set to "production"

# ── Environment ───────────────────────────────────────────────────────────────
# "production" enables startup security checks (JWT secret, CORS validation).
# Leave as "development" for local dev.
ENV=development

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Supported: openai | groq | anthropic | gemini | mistral | cohere | ollama
LLM_PROVIDER=groq
# REQUIRED: replace with your real API key
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemma2-9b-it
# Only needed for ollama or custom OpenAI-compatible endpoints
LLM_BASE_URL=

# ── Supabase (leave blank to use local SQLite fallback) ──────────────────────
# If blank, all data is stored in Bot/model/finnexus_dev.db (single-server only).
# IMPORTANT: apply Bot/schema.sql to your Supabase project before first use.
# The increment_total_cash() RPC function in schema.sql must be deployed too.
SUPABASE_URL=
SUPABASE_KEY=

# ── News API (optional) ───────────────────────────────────────────────────────
# Without this, static fallback headlines are used in RAG context and /market/news.
NEWSAPI_KEY=

# ── ChromaDB (optional) ───────────────────────────────────────────────────────
# Defaults to Data/chroma_db/ inside the project root.
CHROMA_PERSIST_PATH=

# ── ML Model artifacts directory ─────────────────────────────────────────────
# Defaults to Bot/model/artifacts/. The .pkl files are NOT committed to git;
# they are generated at first startup via synthetic pre-training.
MODEL_DIR=

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_TIMEOUT_SECONDS=3600

# ── Redis (optional) ──────────────────────────────────────────────────────────
# Without REDIS_URL, sessions fall back to a local SQLite store.
# For multi-instance / horizontal scaling, Redis is REQUIRED.
# Example: redis://localhost:6379/0
REDIS_URL=

# ── Backend Auth & Security ───────────────────────────────────────────────────
# REQUIRED IN PRODUCTION: generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The server will refuse to start if this is blank or a known insecure value
# when ENV=production.
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Optional: set a shared API key for external service consumers
FINNEXUS_API_KEY=

# CORS origins (comma-separated, no trailing slashes).
# IN PRODUCTION: set to your frontend domain only, e.g.:
#   CORS_ORIGINS=https://app.finnexus.io
# The server will refuse to start in production if this contains localhost.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ── Frontend ──────────────────────────────────────────────────────────────────
# Backend URL. Change to your production API domain when deploying.
VITE_API_URL=http://localhost:8000

# Set to "true" to connect the live backend.
# When "false" (default), all pages show static mock data with a visible banner.
# NOTE: set this to "true" in production — otherwise users see demo data.
VITE_USE_API=false

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
